generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===========================================================================
// Identity
// ===========================================================================

model User {
  id           Int      @id @default(autoincrement())
  phone        String?  @unique
  email        String?  @unique
  passwordHash String
  displayName  String
  avatarUrl    String   @default("")
  marketCode   String   @default("default")
  country      String   @default("XX")
  vipLevel     Int      @default(0)
  nobleLevel   Int      @default(0)
  isBot        Boolean  @default(false)
  referrerCode String?
  agencyId     Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  agency         Agency?             @relation(fields: [agencyId], references: [id])
  wallet         Wallet?
  bets           Bet[]
  sessions       GameSession[]
  giftsSent      GiftTransaction[]   @relation("GiftSender")
  giftsReceived  GiftTransaction[]   @relation("GiftRecipient")
  restrictions   PlayerRestriction[]
  recharges      Recharge[]
  otps           OtpCode[]
  rankings       Ranking[]
  roomsCreated   Room[]              @relation("RoomHost")
  participations RoomParticipant[]
  complaints     Complaint[]
  supportTickets SupportTicket[]
  refreshTokens  Session[]
  passwordResets PasswordResetToken[]
  agencyMembers  AgencyMember[]
  adminNotes     AdminNote[]
  conversations  ConversationParticipant[]
  sentMessages   DirectMessage[] @relation("MessageSender")
  following      Follow[]         @relation("FollowFollower")
  followers      Follow[]         @relation("FollowFollowing")
  blocks         UserBlock[]      @relation("BlockBlocker")
  blockedBy      UserBlock[]      @relation("BlockBlocked")
  reportsMade    UserReport[]     @relation("ReportReporter")
  reportsAgainst UserReport[]     @relation("ReportReported")

  @@index([agencyId])
  @@index([marketCode])
  @@index([createdAt])
}

model OtpCode {
  id         Int      @id @default(autoincrement())
  identifier String
  code       String
  expiresAt  DateTime
  consumed   Boolean  @default(false)
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id])
  userId     Int?

  @@index([identifier])
}

model Session {
  id        Int       @id @default(autoincrement())
  userId    Int
  tokenHash String    @unique
  userAgent String    @default("")
  ip        String    @default("")
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id])

  @@index([userId])
}

/**
 * Password-reset token (Prompt 14).
 *
 * One row per reset request. `tokenHash` is the SHA-256 of the raw token
 * sent to the user (we never store the raw token). `consumedAt` marks
 * the token as used — a token can be consumed exactly once. `expiresAt`
 * is short-lived (15 minutes by default) so a leaked token is time-boxed.
 *
 * Cascade-deletes with the User so a deleted account cleans up its
 * pending reset tokens.
 */
model PasswordResetToken {
  id         Int       @id @default(autoincrement())
  userId     Int
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AdminUser {
  id           Int       @id @default(autoincrement())
  username     String    @unique
  email        String    @unique
  passwordHash String
  displayName  String
  roleId       Int
  agencyId     Int?
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  role                 Role                  @relation(fields: [roleId], references: [id])
  agency               Agency?               @relation(fields: [agencyId], references: [id])
  auditLogs            AuditLog[]
  refunds              Refund[]
  adminNotes           AdminNote[]
  assignedTickets      SupportTicket[]       @relation("TicketAssignee")
  ticketMessages       TicketMessage[]
  // Operations module back-relations (Prompt 12). Named relations so
  // the existing implicit relations are unaffected.
  maintenanceCreated   MaintenanceSchedule[] @relation("MaintenanceCreator")
  maintenanceScheduled MaintenanceSchedule[] @relation("MaintenanceScheduler")
  maintenanceEvents    MaintenanceEvent[]    @relation("MaintenanceEventActor")
  backupsCreated       BackupRecord[]        @relation("BackupCreator")
  recoveriesRequested  RecoveryRecord[]      @relation("RecoveryRequester")
  incidentsAssigned    OperationalIncident[] @relation("IncidentAssignee")
  incidentsCreated     OperationalIncident[] @relation("IncidentCreator")
  alertsAcked          SystemAlert[]         @relation("AlertAckedBy")
  alertsResolved       SystemAlert[]         @relation("AlertResolvedBy")

  @@index([roleId])
}

model Role {
  id          Int              @id @default(autoincrement())
  key         String           @unique
  name        String
  description String           @default("")
  isSystem    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  permissions RolePermission[]
  adminUsers  AdminUser[]

  @@index([key])
}

model Permission {
  id              Int              @id @default(autoincrement())
  key             String           @unique
  description     String           @default("")
  rolePermissions RolePermission[]
}

model RolePermission {
  roleId       Int
  permissionId Int
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
}

model Agency {
  id             Int      @id @default(autoincrement())
  name           String
  code           String   @unique
  description    String   @default("")
  contactEmail   String   @default("")
  contactPhone   String   @default("")
  country        String   @default("XX")
  commissionRate Float    @default(0.1)
  parentId       Int?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  parent      Agency?            @relation("AgencyTree", fields: [parentId], references: [id])
  children    Agency[]           @relation("AgencyTree")
  members     AgencyMember[]
  users       User[]
  admins      AdminUser[]
  withdrawals AgencyWithdrawal[]

  @@index([parentId])
  @@index([active])
  @@index([createdAt])
}

model AgencyMember {
  id       Int      @id @default(autoincrement())
  agencyId Int
  userId   Int
  joinedAt DateTime @default(now())
  agency   Agency   @relation(fields: [agencyId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@unique([agencyId, userId])
}

model AgencyWithdrawal {
  id        Int      @id @default(autoincrement())
  agencyId  Int
  amount    Int
  status    String   @default("pending") // pending | approved | rejected
  note      String   @default("")
  createdAt DateTime @default(now())
  agency    Agency   @relation(fields: [agencyId], references: [id])

  @@index([agencyId])
}

// ===========================================================================
// Content
// ===========================================================================

model Room {
  id           Int               @id @default(autoincrement())
  title        String
  type         String // live | voice | party
  slots        Int               @default(5)
  country      String            @default("XX")
  hostId       Int
  isLocked     Boolean           @default(false)
  livekitRoom  String            @default("")
  createdAt    DateTime          @default(now())
  closedAt     DateTime?
  host         User              @relation("RoomHost", fields: [hostId], references: [id])
  participants RoomParticipant[]
  reports      RoomReport[]
  events       RoomEvent[]

  @@index([type])
  @@index([country])
  @@index([hostId])
  @@index([closedAt])
}

model RoomParticipant {
  id        Int       @id @default(autoincrement())
  roomId    Int
  userId    Int
  slotIndex Int?
  role      String    @default("audience") // host | cohost | audience
  muted     Boolean   @default(false)
  joinedAt  DateTime  @default(now())
  leftAt    DateTime?
  kickedAt  DateTime?
  room      Room      @relation(fields: [roomId], references: [id])
  user      User      @relation(fields: [userId], references: [id])

  @@unique([roomId, userId])
  @@index([userId])
}

model Gift {
  id           Int               @id @default(autoincrement())
  name         String
  iconUrl      String            @default("")
  price        Int
  category     String            @default("basic")
  animation    String            @default("small") // none | small | full
  enabled      Boolean           @default(true)
  sortOrder    Int               @default(0)
  transactions GiftTransaction[]

  @@index([category])
}

model GiftTransaction {
  id               Int      @id @default(autoincrement())
  senderId         Int
  recipientId      Int
  giftId           Int
  roomId           Int?
  quantity         Int      @default(1)
  totalPrice       Int
  agencyCommission Int      @default(0)
  createdAt        DateTime @default(now())
  gift             Gift     @relation(fields: [giftId], references: [id])
  sender           User     @relation("GiftSender", fields: [senderId], references: [id])
  recipient        User     @relation("GiftRecipient", fields: [recipientId], references: [id])

  @@index([senderId])
  @@index([recipientId])
  @@index([createdAt])
}

model Ranking {
  id        Int      @id @default(autoincrement())
  userId    Int
  period    String // daily | weekly | monthly
  scope     String   @default("global")
  points    Int      @default(0)
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, period, scope])
  @@index([period, points])
}

model ShortVideo {
  id        Int      @id @default(autoincrement())
  authorId  Int
  title     String   @default("")
  videoUrl  String
  coverUrl  String   @default("")
  likes     Int      @default(0)
  country   String   @default("XX")
  status    String   @default("published") // published | hidden
  createdAt DateTime @default(now())

  @@index([status, createdAt])
}

model Moment {
  id        Int      @id @default(autoincrement())
  authorId  Int
  text      String   @default("")
  imageUrl  String   @default("")
  likes     Int      @default(0)
  country   String   @default("XX")
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ===========================================================================
// Wallet
// ===========================================================================

model Wallet {
  id        Int           @id @default(autoincrement())
  userId    Int           @unique
  balance   Int           @default(0)
  frozen    Boolean       @default(false)
  updatedAt DateTime      @updatedAt
  user      User          @relation(fields: [userId], references: [id])
  entries   LedgerEntry[]
}

model LedgerEntry {
  id           BigInt   @id @default(autoincrement())
  userId       Int
  walletId     Int
  kind         String
  amount       Int // signed: positive credit, negative debit
  balanceAfter Int
  txKey        String   @unique
  refType      String?
  refId        Int?
  meta         Json?
  createdAt    DateTime @default(now())
  wallet       Wallet   @relation(fields: [walletId], references: [id])

  @@index([userId, createdAt])
  @@index([kind])
  @@index([refType, refId])
}

model Recharge {
  id          Int      @id @default(autoincrement())
  userId      Int
  amount      Int
  provider    String   @default("fake")
  externalId  String   @unique
  status      String   @default("succeeded") // pending | succeeded | failed
  meta        Json?
  createdById Int? // null = self, else AdminUser
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])
  refunds     Refund[]

  @@index([userId])
  @@index([status])
}

model Refund {
  id         Int       @id @default(autoincrement())
  rechargeId Int       @unique
  amount     Int
  reason     String    @default("")
  adminId    Int
  createdAt  DateTime  @default(now())
  recharge   Recharge  @relation(fields: [rechargeId], references: [id])
  admin      AdminUser @relation(fields: [adminId], references: [id])
}

// ===========================================================================
// Games
// ===========================================================================

model GameProvider {
  id                Int                 @id @default(autoincrement())
  name              String
  code              String              @unique
  apiBase           String
  apiKey            String
  apiSecret         String
  commissionPct     Float               @default(0)
  enabled           Boolean             @default(true)
  games             Game[]
  bills             ProviderBill[]
  apiKeys           ApiAccessKey[]
  settlementRecords SettlementRecord[]
  monthlyFees       MonthlyServiceFee[]
  integrationFees   IntegrationFee[]
}

model Game {
  id           Int           @id @default(autoincrement())
  code         String        @unique
  name         String
  version      String        @default("1.0.0")
  status       String        @default("active") // active | maintenance | disabled
  isPro        Boolean       @default(false)
  providerId   Int?
  thumbnailUrl String        @default("")
  sortOrder    Int           @default(0)
  provider     GameProvider? @relation(fields: [providerId], references: [id])
  configs      GameConfig[]
  rounds       GameRound[]
  sessions     GameSession[]
  rtpSnapshots RtpSnapshot[]
  bets         Bet[]
}

model GameConfig {
  id             Int    @id @default(autoincrement())
  gameId         Int
  marketId       Int
  minBet         Int    @default(1)
  maxBet         Int    @default(10000)
  bettingSeconds Int    @default(30)
  timeoutSeconds Int    @default(120)
  stuckPolicy    String @default("refund") // refund | settle
  game           Game   @relation(fields: [gameId], references: [id])
  market         Market @relation(fields: [marketId], references: [id])

  @@unique([gameId, marketId])
}

model GameRound {
  id           Int       @id @default(autoincrement())
  roundId      String    @unique // provider's round identifier
  gameId       Int
  sessionInfo  Json?
  status       String    @default("open") // open | settled | cancelled
  startedAt    DateTime  @default(now())
  endedAt      DateTime?
  resultJson   Json?
  settleSource String    @default("webhook") // webhook | recovery | admin
  game         Game      @relation(fields: [gameId], references: [id])
  bets         Bet[]

  @@index([gameId, startedAt])
  @@index([status])
}

model GameSession {
  id         Int       @id @default(autoincrement())
  sessionKey String    @unique
  userId     Int
  gameId     Int
  marketCode String    @default("default")
  openedAt   DateTime  @default(now())
  closedAt   DateTime?
  user       User      @relation(fields: [userId], references: [id])
  game       Game      @relation(fields: [gameId], references: [id])
  bets       Bet[]

  @@index([userId])
  @@index([gameId])
}

model Bet {
  id           Int         @id @default(autoincrement())
  roundId      Int
  sessionId    Int
  userId       Int
  gameKey      Int
  amount       Int
  status       String      @default("placed") // placed | won | lost | cancelled | refunded
  payout       Int         @default(0)
  providerTxId String      @unique
  createdAt    DateTime    @default(now())
  settledAt    DateTime?
  round        GameRound   @relation(fields: [roundId], references: [id])
  session      GameSession @relation(fields: [sessionId], references: [id])
  user         User        @relation(fields: [userId], references: [id])
  game         Game        @relation(fields: [gameKey], references: [id])
  payouts      Payout[]

  @@unique([roundId, providerTxId])
  @@index([userId, createdAt])
  @@index([roundId])
  @@index([status])
}

model Payout {
  id         Int      @id @default(autoincrement())
  betId      Int
  amount     Int
  multiplier Float    @default(1)
  createdAt  DateTime @default(now())
  bet        Bet      @relation(fields: [betId], references: [id])
}

model RtpSnapshot {
  id          Int      @id @default(autoincrement())
  gameId      Int
  windowStart DateTime
  windowEnd   DateTime
  totalBet    Int      @default(0)
  totalPayout Int      @default(0)
  rtp         Float    @default(0)
  game        Game     @relation(fields: [gameId], references: [id])

  @@index([gameId, windowStart])
}

// ===========================================================================
// Control
// ===========================================================================

model PlayerRestriction {
  id        Int       @id @default(autoincrement())
  userId    Int
  type      String // ban | mute | freeze_wallet | kick
  reason    String    @default("")
  createdBy Int
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([type, expiresAt])
}

model SuspiciousEvent {
  id        Int      @id @default(autoincrement())
  userId    Int?
  kind      String
  severity  String   @default("low") // low | medium | high
  details   Json?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([severity])
}

model Complaint {
  id           Int      @id @default(autoincrement())
  userId       Int
  subject      String
  body         String
  status       String   @default("open") // open | in_progress | resolved | rejected
  assigneeNote String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id])

  @@index([status])
}

model ApiAccessKey {
  id          Int          @id @default(autoincrement())
  label       String
  providerId  Int
  key         String       @unique
  ipAllowList String       @default("127.0.0.1,::1")
  enabled     Boolean      @default(true)
  provider    GameProvider @relation(fields: [providerId], references: [id])
}

model ApiErrorLog {
  id        Int      @id @default(autoincrement())
  source    String   @default("provider")
  route     String
  message   String
  payload   Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([source])
}

model AuditLog {
  id        Int        @id @default(autoincrement())
  adminId   Int?
  action    String
  entity    String
  entityId  String?
  before    Json?
  after     Json?
  ip        String     @default("")
  createdAt DateTime   @default(now())
  admin     AdminUser? @relation(fields: [adminId], references: [id])

  @@index([entity, entityId])
  @@index([adminId])
  @@index([createdAt])
}

/**
 * Internal administrative notes attached to a user.
 * Created by Super Admins to record moderation context, review history, and
 * shift hand-off notes. NEVER exposed to the mobile app — these are internal
 * records used to coordinate admin actions.
 * `internal` defaults to true; even when set to false, the field is still
 * surfaced only inside the admin panel (no public endpoint reads it). The
 * flag exists so future customer-facing note features can opt-in per note.
 */
model AdminNote {
  id        Int        @id @default(autoincrement())
  userId    Int
  adminId   Int?
  category  String     @default("general") // general | review | moderation | escalation | financial | other
  body      String
  internal  Boolean    @default(true)
  createdAt DateTime   @default(now())
  user      User       @relation(fields: [userId], references: [id])
  admin     AdminUser? @relation(fields: [adminId], references: [id])

  @@index([userId, createdAt])
  @@index([adminId])
  @@index([category])
}

model SecurityEvent {
  id        Int      @id @default(autoincrement())
  kind      String
  message   String
  ip        String   @default("")
  meta      Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/**
 * Room-level report / complaint. Links a report to a specific room (and
 * optionally to a reported user within that room). This is separate from the
 * existing user-level `Complaint` model — room reports carry roomId +
 * optional reportedUserId context that the user-level complaint lacks.
 * Status flow: open → in_review → resolved | dismissed.
 * Reporter identity is stored but NOT exposed to the reported user or to
 * admins who lack `rooms.read` permission.
 */
model RoomReport {
  id             Int      @id @default(autoincrement())
  roomId         Int
  reporterId     Int?
  reportedUserId Int?
  category       String   @default("other") // harassment | inappropriate_content | spam | impersonation | suspicious | other
  description    String   @default("")
  status         String   @default("open") // open | in_review | resolved | dismissed
  reviewerId     Int?
  reviewNote     String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  room           Room     @relation(fields: [roomId], references: [id])

  @@index([roomId])
  @@index([status])
  @@index([category])
  @@index([createdAt])
}

/**
 * Room event timeline — records significant room lifecycle events for the
 * admin event-history view. Events are append-only (never updated or
 * deleted). Each event records the actor (userId for user-initiated events,
 * adminId for admin-initiated events) and a JSON details payload.
 */
model RoomEvent {
  id        Int      @id @default(autoincrement())
  roomId    Int
  type      String // created | closed | participant_joined | participant_left | participant_kicked | participant_muted | participant_unmuted | report_filed | report_resolved | admin_action
  userId    Int?
  adminId   Int?
  details   Json?
  createdAt DateTime @default(now())
  room      Room     @relation(fields: [roomId], references: [id])

  @@index([roomId, createdAt])
  @@index([type])
}

// ===========================================================================
// Settlement
// ===========================================================================

model ProviderBill {
  id               Int          @id @default(autoincrement())
  providerId       Int
  periodStart      DateTime
  periodEnd        DateTime
  grossBets        Int          @default(0)
  grossPayout      Int          @default(0)
  commissionPct    Float        @default(0)
  commissionAmount Int          @default(0)
  serviceFee       Int          @default(0)
  netPayable       Int          @default(0)
  status           String       @default("draft") // draft | confirmed | paid
  createdAt        DateTime     @default(now())
  provider         GameProvider @relation(fields: [providerId], references: [id])

  @@index([providerId, periodStart])
}

model SettlementRecord {
  id         Int          @id @default(autoincrement())
  providerId Int
  billId     Int?
  amount     Int
  direction  String       @default("payable") // payable | receivable
  method     String       @default("bank")
  note       String       @default("")
  createdAt  DateTime     @default(now())
  provider   GameProvider @relation(fields: [providerId], references: [id])

  @@index([providerId])
}

model MonthlyServiceFee {
  id             Int           @id @default(autoincrement())
  providerId     Int
  month          DateTime
  amount         Int
  note           String        @default("")
  createdAt      DateTime      @default(now())
  gameProvider   GameProvider? @relation(fields: [gameProviderId], references: [id])
  gameProviderId Int?

  @@unique([providerId, month])
}

model IntegrationFee {
  id             Int           @id @default(autoincrement())
  providerId     Int
  gameCode       String
  amount         Int
  paid           Boolean       @default(false)
  note           String        @default("")
  createdAt      DateTime      @default(now())
  gameProvider   GameProvider? @relation(fields: [gameProviderId], references: [id])
  gameProviderId Int?

  @@index([providerId])
}

// ===========================================================================
// Config
// ===========================================================================

model Setting {
  key         String   @id
  value       String
  description String   @default("")
  updatedAt   DateTime @updatedAt
}

model FeatureFlag {
  id          Int     @id @default(autoincrement())
  key         String  @unique
  description String  @default("")
  enabled     Boolean @default(false)
  rolloutPct  Int     @default(100)
}

model Market {
  id               Int             @id @default(autoincrement())
  code             String          @unique
  name             String
  realMoneyEnabled Boolean         @default(false)
  enabled          Boolean         @default(true)
  configs          GameConfig[]
  brandConfigs     BrandConfig[]
  countryFilters   CountryFilter[]
}

model BrandConfig {
  id           Int    @id @default(autoincrement())
  marketId     Int    @unique
  appName      String
  logoUrl      String @default("")
  primaryColor String @default("#7c3aed")
  accentColor  String @default("#f43f5e")
  bottomTabs   Json   @default("[]")
  market       Market @relation(fields: [marketId], references: [id])
}

model CountryFilter {
  id       Int     @id @default(autoincrement())
  marketId Int
  country  String
  blocked  Boolean @default(false)
  market   Market  @relation(fields: [marketId], references: [id])

  @@unique([marketId, country])
}

// ===========================================================================
// Reporting rollups
// ===========================================================================

model DailyRevenue {
  day         DateTime @id
  betsCount   Int      @default(0)
  betsAmount  Int      @default(0)
  winsCount   Int      @default(0)
  winsAmount  Int      @default(0)
  giftsAmount Int      @default(0)
  recharges   Int      @default(0)
  revenue     Int      @default(0) // bets - wins (house coin margin)
}

// ===========================================================================
// Support tickets (Prompt 11)
// ===========================================================================

/**
 * Support ticket — created by users (via API) or by admins on behalf of users.
 * Tracks subject, category, priority, status, and assignment.
 */
model SupportTicket {
  id          Int      @id @default(autoincrement())
  userId      Int
  subject     String
  description String   @default("")
  category    String   @default("other")
  priority    String   @default("normal") // low | normal | high | urgent
  status      String   @default("new") // new | open | in_progress | waiting_user | waiting_internal | escalated | resolved | closed
  assigneeId  Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User            @relation(fields: [userId], references: [id])
  assignee AdminUser?      @relation("TicketAssignee", fields: [assigneeId], references: [id])
  messages TicketMessage[]

  @@index([userId])
  @@index([status])
  @@index([priority])
  @@index([assigneeId])
  @@index([createdAt])
}

/**
 * Ticket message — either a customer-facing reply or an internal note.
 * Internal notes are NEVER exposed to users through the user-facing API.
 */
model TicketMessage {
  id         Int      @id @default(autoincrement())
  ticketId   Int
  authorId   Int? // null = user; non-null = admin
  authorType String   @default("user") // user | admin
  body       String
  isInternal Boolean  @default(false) // internal notes never exposed to users
  createdAt  DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id])
  author AdminUser?    @relation(fields: [authorId], references: [id])

  @@index([ticketId, createdAt])
}

// ===========================================================================
// Platform Operations, Monitoring, Maintenance & Backup (Prompt 12)
// ===========================================================================
//
// The following models back the Operations module. They are appenditive —
// no existing column or relation is changed. All statuses / severities are
// free-text columns constrained by Zod at the API boundary (see
// packages/shared/src/index.ts → MAINTENANCE_STATUSES etc.) so the schema
// stays flexible while the API refuses to persist unknown values.

/**
 * Maintenance schedule — a planned maintenance window for a single module
 * (or the whole platform). `status` transitions are:
 * scheduled → active → completed
 * │
 * └→ cancelled
 * `createdById` / `scheduledById` are AdminUser FKs. The maintenance notice
 * shown to end users is rendered from `title` + `message` + `startAt` +
 * `endAt`. The `internalNotes` field is admin-only.
 * `scope` is one of MAINTENANCE_SCOPES: `platform | live | games | wallet |
 * integration`. The admin panel can only schedule maintenance for scopes
 * the backend can enforce — today this is the platform-wide banner; full
 * per-module enforcement requires middleware on the user-facing routes
 * (documented in docs/RUNBOOK.md).
 */
model MaintenanceSchedule {
  id            Int       @id @default(autoincrement())
  scope         String    @default("platform") // platform | live | games | wallet | integration
  title         String
  message       String    @default("")
  status        String    @default("scheduled") // scheduled | active | completed | cancelled
  startAt       DateTime
  endAt         DateTime
  internalNotes String    @default("")
  createdById   Int
  scheduledById Int?
  activatedAt   DateTime?
  completedAt   DateTime?
  cancelledAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  createdBy   AdminUser          @relation("MaintenanceCreator", fields: [createdById], references: [id])
  scheduledBy AdminUser?         @relation("MaintenanceScheduler", fields: [scheduledById], references: [id])
  events      MaintenanceEvent[]

  @@index([scope, status])
  @@index([status, startAt])
  @@index([createdById])
}

/**
 * Maintenance event log — append-only audit trail per schedule. Each row
 * records an admin-initiated transition (`created`, `started`, `ended`,
 * `cancelled`, `extended`, `rescheduled`, `updated`) plus a free-text
 * reason. Records are never updated or deleted.
 */
model MaintenanceEvent {
  id            Int      @id @default(autoincrement())
  maintenanceId Int
  type          String // created | started | ended | cancelled | extended | rescheduled | updated
  note          String   @default("")
  adminId       Int?
  createdAt     DateTime @default(now())

  maintenance MaintenanceSchedule @relation(fields: [maintenanceId], references: [id], onDelete: Cascade)
  admin       AdminUser?          @relation("MaintenanceEventActor", fields: [adminId], references: [id])

  @@index([maintenanceId, createdAt])
  @@index([type])
}

/**
 * Backup record — one row per backup attempt. `status` transitions:
 * pending → running → succeeded → verified
 * └→ failed
 * ↓ (after retention)
 * expired / deleted
 * The `location` field stores a masked path or container URI (no
 * credentials). `checksum` is the SHA-256 of the backup file computed
 * after creation (used to detect tampering / verify integrity). `sizeBytes`
 * is the file size as reported by the filesystem after the script
 * completes. Records are only created when the underlying backup script
 * is invoked through the API; if `BACKUP_SCRIPT_PATH` is not configured,
 * the create endpoint returns `not_configured` and no row is persisted.
 * `meta` is a JSON column reserved for provider-specific metadata (e.g.
 * Postgres version, encryption flag) — never secrets.
 */
model BackupRecord {
  id          Int       @id @default(autoincrement())
  kind        String    @default("database") // database | config | media | application
  scope       String    @default("platform")
  status      String    @default("pending") // pending | running | succeeded | failed | verified | expired | deleted
  location    String    @default("") // masked path — no credentials
  sizeBytes   Int?
  checksum    String?
  startedAt   DateTime?
  completedAt DateTime?
  createdById Int?
  note        String    @default("")
  error       String    @default("")
  meta        Json?
  createdAt   DateTime  @default(now())

  createdBy  AdminUser?       @relation("BackupCreator", fields: [createdById], references: [id])
  recoveries RecoveryRecord[]

  @@index([kind, status])
  @@index([status, createdAt])
  @@index([createdById])
}

/**
 * Recovery record — one row per restore attempt. `targetEnvironment` is
 * constrained to `staging` or `sandbox`; the API refuses `production`
 * restores from the admin UI. Restores against production must be
 * performed manually on the server (see infra/restore.sh).
 * `impact` documents the destructive scope of the restore (which tables
 * get overwritten). `result` records the outcome — `succeeded` only
 * when the recovery script exited 0 AND the post-restore integrity check
 * passed.
 */
model RecoveryRecord {
  id                Int       @id @default(autoincrement())
  backupId          Int
  status            String    @default("pending") // pending | running | succeeded | failed | cancelled
  targetEnvironment String    @default("staging") // staging | sandbox — never production
  impact            String    @default("")
  notes             String    @default("")
  result            String    @default("")
  requestedById     Int?
  startedAt         DateTime?
  completedAt       DateTime?
  createdAt         DateTime  @default(now())

  backup      BackupRecord @relation(fields: [backupId], references: [id])
  requestedBy AdminUser?   @relation("RecoveryRequester", fields: [requestedById], references: [id])

  @@index([backupId])
  @@index([status, createdAt])
  @@index([requestedById])
}

/**
 * Health check result — one row per (component × timestamp) check run.
 * `status` is one of HEALTH_STATUSES: `healthy | degraded | down |
 * unknown | not_configured`. Records are kept for the configured retention
 * (default 7 days) so the dashboard can plot a trend without scanning
 * application logs. `responseTimeMs` is null when the check is
 * `not_configured` or `down` (no successful response to measure).
 * `meta` stores structured details (e.g. queue depth, error count) — never
 * secrets. `details` is a short human-readable message shown to admins.
 */
model HealthCheckResult {
  id             Int      @id @default(autoincrement())
  component      String // frontend | backend | database | auth | api | file_storage | workers | queue | notifications | providers | wallet | webhooks
  status         String   @default("unknown") // healthy | degraded | down | unknown | not_configured
  responseTimeMs Int?
  details        String   @default("")
  error          String   @default("")
  meta           Json?
  checkedAt      DateTime @default(now())

  @@index([component, checkedAt])
  @@index([status, checkedAt])
}

/**
 * Operational incident — a tracked event affecting platform availability
 * or correctness. `status` transitions: `open → investigating →
 * identified → monitoring → resolved → closed`. `severity` is one of
 * INCIDENT_SEVERITIES. `affectedService` is a free-text label (e.g.
 * "postgres", "livekit", "mockcorp-provider"). Internal notes / resolution
 * details are admin-only.
 */
model OperationalIncident {
  id                Int       @id @default(autoincrement())
  title             String
  description       String    @default("")
  severity          String    @default("medium") // low | medium | high | critical
  status            String    @default("open") // open | investigating | identified | monitoring | resolved | closed
  affectedService   String    @default("")
  assigneeId        Int?
  internalNotes     String    @default("")
  resolutionDetails String    @default("")
  createdById       Int?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  closedAt          DateTime?

  assignee  AdminUser? @relation("IncidentAssignee", fields: [assigneeId], references: [id])
  createdBy AdminUser? @relation("IncidentCreator", fields: [createdById], references: [id])

  @@index([status, severity])
  @@index([assigneeId])
  @@index([affectedService])
  @@index([createdAt])
}

/**
 * Operational alert — raised by the system (or by an admin) when an
 * operational signal crosses a threshold. Alerts are deduplicated by
 * `source + fingerprint` so the same root cause does not flood the
 * dashboard. `status` transitions: `open → acknowledged → resolved`.
 * `fingerprint` is a stable hash of (source + message + severity) so
 * repeated occurrences are collapsed into a count rather than new rows.
 * `meta` carries the structured context (metric value, threshold, time).
 */
model SystemAlert {
  id              Int       @id @default(autoincrement())
  source          String // database | api | redis | scheduler | provider | webhook | wallet | maintenance | backup
  severity        String    @default("warning") // info | warning | high | critical
  status          String    @default("open") // open | acknowledged | resolved
  message         String
  fingerprint     String    @default("")
  meta            Json?
  ackedById       Int?
  resolvedById    Int?
  acknowledgedAt  DateTime?
  resolvedAt      DateTime?
  resolutionNotes String    @default("")
  occurrenceCount Int       @default(1)
  lastOccurredAt  DateTime  @default(now())
  createdAt       DateTime  @default(now())

  ackedBy    AdminUser? @relation("AlertAckedBy", fields: [ackedById], references: [id])
  resolvedBy AdminUser? @relation("AlertResolvedBy", fields: [resolvedById], references: [id])

  @@index([status, severity])
  @@index([source, fingerprint])
  @@index([createdAt])
}

// ===========================================================================
// Direct Messaging (Prompt 19)
// ===========================================================================

/**
 * Conversation — a private 1:1 or group chat. `type` is "private" (1:1)
 * or "group". `title` is used for group chats (empty for 1:1).
 * `lastMessageAt` is updated on every new message so the conversation
 * list can be sorted by recency without a join.
 */
model Conversation {
  id           Int       @id @default(autoincrement())
  type         String    @default("private") // private | group
  title        String    @default("")
  createdAt    DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastMessageAt DateTime?

  participants ConversationParticipant[]
  messages     DirectMessage[]

  @@index([type])
  @@index([lastMessageAt])
}

/**
 * ConversationParticipant — a user's membership in a conversation.
 * `role` is "admin" (group creator) or "member". `lastReadAt` tracks
 * read receipts (null = never read). `muted` + `pinned` are per-user
 * preferences. `leftAt` marks a user who left a group (their messages
 * remain; they just can't see new ones).
 */
model ConversationParticipant {
  id             Int       @id @default(autoincrement())
  conversationId Int
  userId         Int
  role           String    @default("member") // admin | member
  lastReadAt     DateTime?
  muted          Boolean   @default(false)
  pinned         Boolean   @default(false)
  joinedAt       DateTime  @default(now())
  leftAt         DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
  @@index([conversationId])
}

/**
 * DirectMessage — a single message in a conversation. `body` is text
 * (300 chars max, matching the room chat limit). Attachments, reactions,
 * and edits are future extensions — the table is designed so adding a
 * `replyToId`, `editedAt`, or `attachmentUrl` column doesn't break the
 * existing query patterns.
 */
model DirectMessage {
  id             Int      @id @default(autoincrement())
  conversationId Int
  senderId       Int
  body           String   @default("")
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderId])
}

// ===========================================================================
// Social Connections (Prompt 16)
// ===========================================================================

model Follow {
  id          Int      @id @default(autoincrement())
  followerId  Int
  followingId Int
  createdAt   DateTime @default(now())

  follower  User @relation("FollowFollower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("FollowFollowing", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model UserBlock {
  id         Int      @id @default(autoincrement())
  blockerId  Int
  blockedId  Int
  createdAt  DateTime @default(now())

  blocker User @relation("BlockBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("BlockBlocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
}

model UserReport {
  id         Int      @id @default(autoincrement())
  reporterId Int
  reportedId Int
  reason     String   @default("other")
  details    String   @default("")
  status     String   @default("open")
  createdAt  DateTime @default(now())

  reporter User @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reported User @relation("ReportReported", fields: [reportedId], references: [id], onDelete: Cascade)

  @@index([reporterId])
  @@index([reportedId])
  @@index([status])
}
