# SM Live API environment
NODE_ENV=development
PORT=4001
LOG_LEVEL=info

# Postgres (docker compose exposes on localhost)
DATABASE_URL=postgresql://sm_live:sm_live@localhost:5433/sm_live?schema=public

# Redis
REDIS_URL=redis://localhost:6380

# LiveKit (matches infra/docker-compose.yml devkey)
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret_that_is_at_least_16_chars

# Auth
JWT_SECRET=change-me-in-production-min-32-chars!!
ADMIN_JWT_SECRET=change-me-also-in-production-min-32c

# Seeded super admin (used by prisma/seed.ts)
SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_PASSWORD=SuperAdmin123!
SUPER_ADMIN_EMAIL=admin@sm-live.local

# CORS allow list, comma separated origins
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Public base URL of this API as seen by the provider
PUBLIC_API_BASE=http://localhost:4001

# Fake payment adapter always succeeds in dev
PAYMENT_ADAPTER=fake

# --- Platform Operations (Prompt 12) -----------------------------------------
# Backup discovery — directory the API scans for verified backup files
# (sm_live_*.sql.gz). Empty = endpoint returns not_configured.
#BACKUP_DIR_PATH=./infra/backups
# Backup creation — path to an executable backup script invoked by the API
# on POST /v1/admin/operations/backups/run. Empty = backup creation
# disabled from admin UI (must be created out-of-band via cron / CI).
#BACKUP_SCRIPT_PATH=./infra/backup.sh
# Restore execution — path to an executable restore script invoked by the
# API for staging/sandbox restores only. Production restores are ALWAYS
# manual (see infra/restore.sh).
#RESTORE_SCRIPT_PATH=./infra/restore.sh
# When true, user-facing routes return 503 during an active platform-wide
# maintenance window. Default false in dev so fixtures stay reachable.
MAINTENANCE_STRICT=false
# Health-check result retention in days (results older than this are pruned).
HEALTH_CHECK_RETENTION_DAYS=7
