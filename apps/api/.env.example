# SM Live API environment
NODE_ENV=development
PORT=4001
LOG_LEVEL=info

# Postgres (docker compose exposes on localhost)
DATABASE_URL=postgresql://sm_live:sm_live@localhost:5433/sm_live?schema=public

# Redis
REDIS_URL=redis://localhost:6380

# LiveKit (matches infra/docker-compose.yml devkey)
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret_that_is_at_least_16_chars

# Auth
JWT_SECRET=change-me-in-production-min-32-chars!!
ADMIN_JWT_SECRET=change-me-also-in-production-min-32c

# Seeded super admin (used by prisma/seed.ts)
SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_PASSWORD=SuperAdmin123!
SUPER_ADMIN_EMAIL=admin@sm-live.local

# CORS allow list, comma separated origins
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Public base URL of this API as seen by the provider
PUBLIC_API_BASE=http://localhost:4001

# Fake payment adapter always succeeds in dev
PAYMENT_ADAPTER=fake
