# Copy to infra/.env and EDIT for production (used by docker-compose.prod.yml)
NODE_ENV=production
PORT=4000
DATABASE_URL=postgresql://sm_live:CHANGE_ME@postgres:5432/sm_live?schema=public
REDIS_URL=redis://redis:6379
LIVEKIT_URL=ws://livekit:7880
LIVEKIT_API_KEY=CHANGE_ME
LIVEKIT_API_SECRET=CHANGE_ME_at_least_16_chars
JWT_SECRET=CHANGE_ME_random_32_chars_minimum___
ADMIN_JWT_SECRET=CHANGE_ME_random_32_chars_minimum
SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_PASSWORD=CHANGE_ME
SUPER_ADMIN_EMAIL=admin@example.com
CORS_ORIGINS=https://admin.example.com
PUBLIC_API_BASE=https://api.example.com
